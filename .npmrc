# npm 10.9.2 (bundled with Node 22.14.0) crashes while resolving Nuxt's peer
# dependency graph:
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#     at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js:1289)
# This flag sidesteps that resolution path so `npm install` completes.
# Remove it once npm is upgraded to a version without the bug, and re-run a
# clean `npm install` to confirm the lockfile still resolves.
legacy-peer-deps=true
